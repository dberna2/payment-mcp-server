{
  "name": "getCustomerPaymentHistory",
  "description": "Get all customer payment history",
  "schema": {
    "type": "object",
    "properties": {
      "customerId": {
        "type": "string",
        "description": "Customer identifier",
        "examples": ["1", "2"]
      },
      "paymentStatus": {
        "type": "string",
        "enum": ["PENDING", "AUTHORIZED", "CANCELLED"],
        "description": "Payment status used to filter the results",
        "default": null
      }
    },
    "required": ["customerId"]
  }
}